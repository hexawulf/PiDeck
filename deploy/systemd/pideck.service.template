# PiDeck systemd unit — rendered by scripts/install.sh --service systemd.
# The @-placeholders (user, app dir, node binary) are filled in and the result
# is checked with `systemd-analyze verify` before it goes to /etc/systemd/system/.
# The app reads its settings from @APP_DIR@/.env itself (dotenv).
[Unit]
Description=PiDeck dashboard
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=NODE_ENV=production
ExecStart=@NODE@ @APP_DIR@/dist/index.js
Restart=on-failure
RestartSec=5
# Baseline sandboxing (override NoNewPrivileges=false in a drop-in if using --sudoers for smartctl/ufw/apt-get).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
UMask=0027

[Install]
WantedBy=multi-user.target
