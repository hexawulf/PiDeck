# PiDeck systemd unit — rendered by scripts/install.sh --service systemd.
# The @-placeholders (user, app dir, node binary) are filled in and the result
# is checked with `systemd-analyze verify` before it goes to /etc/systemd/system/.
# The app reads its settings from @APP_DIR@/.env itself (dotenv).
[Unit]
Description=PiDeck dashboard
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=NODE_ENV=production
ExecStart=@NODE@ @APP_DIR@/dist/index.js
Restart=on-failure
RestartSec=5
# No NoNewPrivileges=, ProtectSystem=, ProtectKernel*, ProtectControlGroups=, or UMask=:
# hub System Update and optional --sudoers rules (smartctl, ufw, apt-get) need setuid sudo
# and write access to system paths.
PrivateTmp=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
