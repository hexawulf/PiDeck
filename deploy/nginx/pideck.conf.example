# PiDeck behind nginx with TLS — example, adjust and install by hand:
#   sudo cp deploy/nginx/pideck.conf.example /etc/nginx/sites-available/pideck
#   sudo ln -s /etc/nginx/sites-available/pideck /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Certificates: certbot (sudo certbot --nginx -d pideck.example.com) or your own.
# PiDeck's session cookie is Secure, so it must be reached over HTTPS; nginx
# passes X-Forwarded-Proto so the app (trust proxy = 1) knows it is HTTPS.
# scripts/install.sh never edits nginx; it only prints these steps.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name pideck.example.com;
    server_tokens off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name pideck.example.com;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/pideck.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pideck.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Log tail can stream (SSE); don't buffer it.
    proxy_buffering off;
    proxy_read_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:5006;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
