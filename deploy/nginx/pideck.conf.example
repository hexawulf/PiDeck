# PiDeck behind nginx with TLS — example, adjust and install by hand:
#   sudo cp deploy/nginx/pideck.conf.example /etc/nginx/sites-available/pideck
#   sudo ln -s /etc/nginx/sites-available/pideck /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Certificates: certbot (sudo certbot --nginx -d pideck.example.com) or your own.
# PiDeck's session cookie is Secure, so it must be reached over HTTPS; nginx
# passes X-Forwarded-Proto so the app (trust proxy = 1) knows it is HTTPS.
# scripts/install.sh never edits nginx; it only prints these steps.

server {
    listen 80;
    listen [::]:80;
    server_name pideck.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name pideck.example.com;

    ssl_certificate     /etc/letsencrypt/live/pideck.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pideck.example.com/privkey.pem;

    # Log tail can stream (SSE); don't buffer it.
    proxy_buffering off;
    proxy_read_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:5006;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
