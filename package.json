{
  "name": "pideck",
  "version": "2.12.0",
  "releaseDate": "2026-11-22",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "dotenv -e .env -- tsx server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build --debug",
    "build:server": "node scripts/prune-dist.mjs --rotate && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --splitting --outdir=dist --metafile=dist/.server-meta.json && node scripts/prune-dist.mjs",
    "build": "npm run build:client && npm run build:server",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "lint": "eslint .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:theme": "bash scripts/check-theme-tokens.sh",
    "check:shell": "shellcheck -x -a -P SCRIPTDIR scripts/*.sh tests/install/*.sh",
    "test:install": "bash tests/install/run.sh"
  },
  "dependencies": {
    "@firebase/app": "0.16.7",
    "@firebase/auth": "1.13.11",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.108.2",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.9",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "express": "^5.3.0",
    "express-session": "^1.18.1",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.76.0",
    "pg": "^8.23.1",
    "pm2": "^7.0.1",
    "postgres": "^3.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^2.15.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcrypt": "^5.0.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^3.3.44",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.13",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "bufferutil": "^4.2.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "google-gax@5": {
      "rimraf": "^6.1.4"
    },
    "gaxios@>=7.0.0 <7.3.1": "^7.3.1",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
