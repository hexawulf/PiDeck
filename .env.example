# PiDeck configuration (.env, mode 0600, never committed).
#
# scripts/install.sh creates .env from this file when it is missing: every
# KEY= line below is copied commented out (as documentation), then the keys
# the installer manages are appended with real values. Re-runs only append
# keys that are missing; they never change a value you set.
# Full reference: docs/INSTALL.md.

# ── Server ──────────────────────────────────────────────────────────────
# production = Secure session cookie, built SPA from dist/. The installer
# sets it; leave it unset for `npm run dev`.
# NODE_ENV=production
# Listen port (the reverse proxy forwards to 127.0.0.1:PORT).
PORT=5006

# ── Secrets (generated by the installer; never printed) ─────────────────
# Long random string: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_LONG_RANDOM
# PostgreSQL: users, sessions, metric history.
DATABASE_URL=postgresql://pideck:CHANGE_ME@localhost:5432/pideck

# Optional extra admin password from the environment / a 0600 file. It is
# always accepted in addition to the database password and cannot be changed
# from Settings, so the installer does not use it (it sets the database
# password instead). Useful for recovery.
# APP_PASSWORD=
# APP_PASSWORD_FILE=/home/you/.config/pideck/admin-password

# ── Security headers / transport ────────────────────────────────────────
# Enforce the Content-Security-Policy (unset = Report-Only). The installer
# sets it for production.
# CSP_ENFORCE=true
# Plain-HTTP LAN mode (scripts/install.sh --lan-http): session cookie without
# `Secure`, so http://<ip>:PORT can log in. The cookie then travels
# unencrypted: trusted networks only. Default: HTTPS via a reverse proxy.
# PIDECK_INSECURE_HTTP=1
# Express "trust proxy": unset = 1 (one reverse proxy). Set false when
# nothing sits in front of PiDeck (--lan-http sets this).
# TRUST_PROXY=false
# Extra origins allowed to call the API with credentials (comma-separated).
# Unset = no CORS headers; the UI is same-origin and does not need them.
# PIDECK_CORS_ORIGIN=https://pideck.example.org
# Session cookie domain. Unset = host-only cookie (recommended).
# COOKIE_DOMAIN=example.org
# SESSION_COOKIE_DOMAIN=example.org   (same; takes precedence)

# ── Logs tab ────────────────────────────────────────────────────────────
# Directory of project logs (*.log) shown under "Project". Default $HOME/logs.
# PIDECK_LOGS_DIR=/home/you/logs
# pm2 logs directory. Default $HOME/.pm2/logs.
# PM2_LOGS_DIR=/home/you/.pm2/logs
# Extra host log files: comma-separated [id:]Label=/absolute/path. The
# optional id keeps pins stable; missing files are hidden. The nginx
# access/error logs and PiDeck's own pm2 logs are always offered.
# PIDECK_HOST_LOGS=app_out:My App Output=/var/log/myapp/out.log,app_err:My App Error=/var/log/myapp/error.log

# ── Hardware widgets ────────────────────────────────────────────────────
# NVMe device for NVMe Health (smartctl). Default: first /dev/nvme0..3 found.
# PIDECK_NVME_DEVICE=/dev/nvme0

# ── Background work / testing ───────────────────────────────────────────
# off = no 60s history/alert sampler (also off when NODE_ENV=test).
# PIDECK_SAMPLER=off
# 1 = POST /api/system/update is a 409 no-op (E2E runs set this).
# PIDECK_DISABLE_SYSTEM_UPDATE=1
