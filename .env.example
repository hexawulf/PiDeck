# PiDeck configuration (.env, mode 0600, never committed).
#
# scripts/install.sh creates .env from this file when it is missing: every
# KEY= line below is copied commented out (as documentation), then the keys
# the installer manages are appended with real values. Re-runs only append
# keys that are missing; they never change a value you set.
# Full reference: docs/INSTALL.md.

# ── Server ──────────────────────────────────────────────────────────────
# production = Secure session cookie, built SPA from dist/. The installer
# sets it; leave it unset for `npm run dev`.
# NODE_ENV=production
# Listen port (the reverse proxy forwards to 127.0.0.1:PORT).
PORT=5006

# ── Secrets (generated by the installer; never printed) ─────────────────
# Long random string: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_LONG_RANDOM
# PostgreSQL: users, sessions, metric history.
DATABASE_URL=postgresql://pideck:CHANGE_ME@localhost:5432/pideck

# Optional extra admin password from the environment / a 0600 file. It is
# always accepted in addition to the database password and cannot be changed
# from Settings, so the installer does not use it (it sets the database
# password instead). Useful for recovery.
# APP_PASSWORD=
# APP_PASSWORD_FILE=/home/you/.config/pideck/admin-password

# ── Security headers / transport ────────────────────────────────────────
# Enforce the Content-Security-Policy (unset = Report-Only). The installer
# sets it for production.
# CSP_ENFORCE=true
# Plain-HTTP LAN mode (scripts/install.sh --lan-http): session cookie without
# `Secure`, so http://<ip>:PORT can log in. The cookie then travels
# unencrypted: trusted networks only. Default: HTTPS via a reverse proxy.
# PIDECK_INSECURE_HTTP=1
# Express "trust proxy": unset = 1 (one reverse proxy). Set false when
# nothing sits in front of PiDeck (--lan-http sets this).
# TRUST_PROXY=false
# Behind Cloudflare's proxy only: count login attempts per CF-Connecting-IP.
# Leave unset otherwise (the header is client-controlled without Cloudflare).
# PIDECK_CLOUDFLARE=1
# Extra origins allowed to call the API with credentials (comma-separated).
# Unset = no CORS headers; the UI is same-origin and does not need them.
# PIDECK_CORS_ORIGIN=https://pideck.example.org
# Session cookie domain. Unset = host-only cookie (recommended).
# COOKIE_DOMAIN=example.org
# SESSION_COOKIE_DOMAIN=example.org   (same; takes precedence)

# ── Logs tab ────────────────────────────────────────────────────────────
# Directory of project logs (*.log) shown under "Project". Default $HOME/logs.
# PIDECK_LOGS_DIR=/home/you/logs
# pm2 logs directory. Default $HOME/.pm2/logs.
# PM2_LOGS_DIR=/home/you/.pm2/logs
# Extra host log files: comma-separated [id:]Label=/absolute/path. The
# optional id keeps pins stable; missing files are hidden. The nginx
# access/error logs and PiDeck's own pm2 logs are always offered.
# PIDECK_HOST_LOGS=app_out:My App Output=/var/log/myapp/out.log,app_err:My App Error=/var/log/myapp/error.log

# ── Hardware widgets ────────────────────────────────────────────────────
# NVMe device for NVMe Health (smartctl). Default: first /dev/nvme0..3 found.
# PIDECK_NVME_DEVICE=/dev/nvme0

# ── Multi-host (docs/INSTALL.md › Add another machine) ───────────────────
# On the HUB: the other machines (agents) it shows, as id=url pairs. Ids
# are [a-z0-9-]{1,32} ("local" is the hub itself); URLs http(s)://ip:port.
# scripts/install.sh --add-host writes these three.
# PIDECK_HOSTS=piapps2=http://192.168.50.120:5016
# One token per host: PIDECK_HOST_TOKEN_<ID> (id upper-cased, - → _).
# PIDECK_HOST_TOKEN_PIAPPS2=<the token the agent printed once>
# Optional names for the host switcher.
# PIDECK_HOST_LABELS=piapps2=piapps2 (LAN)
# Optional: more time (seconds, 1–9; default 5) for a slow host, e.g. a NAS
# that answers late during a media library scan.
# PIDECK_HOST_TIMEOUT_DS920=9
#
# On an AGENT (scripts/install.sh --agent writes these): a read-only
# metrics endpoint for the hub — no UI, login or database.
# PIDECK_MODE=agent
# Address and port to listen on (default 127.0.0.1:5016; the installer
# uses this machine's LAN address). Allow only the hub in the firewall.
# PIDECK_AGENT_BIND=192.168.50.120
# PIDECK_AGENT_PORT=5016
# SHA-256 (hex) of the agent's token; the token itself is never stored here.
# PIDECK_AGENT_TOKEN_SHA256=<64 hex digits>
# Remote logs (2.6, docs/INSTALL.md › Remote logs): off by default. on =
# the hub's Logs tab shows this agent's logs (read-only, redacted here).
# PIDECK_AGENT_LOGS=on
# Files: PIDECK_HOST_LOGS above (same syntax; %Y %m %d and a newest-match
# * allowed in the file name). journald units (user:<unit> for user units):
# PIDECK_AGENT_JOURNAL_UNITS=pideck-agent
# Every Docker container's logs (Engine API, two read-only calls only):
# PIDECK_AGENT_DOCKER_LOGS=on
# PIDECK_AGENT_DOCKER_SOCKET=/var/run/docker.sock
# Mount point whose usage the hub samples for this host (overview tile,
# history). Default /. On a Synology use /volume1 (/ is DSM's system
# partition). Hub or agent.
# PIDECK_DISK_MOUNT=/volume1

# ── Services (systemd, read-only; hub and agents, 2.8) ──────────────────
# Units shown in the Apps tab and watched for alerts, comma-separated;
# user:<unit> for the user manager (needs lingering for the agent user),
# optional Label=<unit>. Invalid names are skipped with a warning.
# PIDECK_SERVICES=nginx,ssh,Database=postgresql@18-main,user:syncthing
# Also list every failed unit (shown, never alerting). Default on.
# PIDECK_SERVICES_FAILED=off
# Hub: minutes a listed unit may be down before its alert (default 3; 1-1440).
# PIDECK_SERVICE_ALERT_MINUTES=3

# ── Background work / testing ───────────────────────────────────────────
# off = no 60s history/alert sampler for any host (also off when NODE_ENV=test).
# PIDECK_SAMPLER=off
# Hours of per-host history the hub keeps (default 24; 1-168). Resolved
# alerts are kept as long. Bad values fall back to the default with a warning.
# PIDECK_HISTORY_HOURS=24
# Minutes an agent must fail every poll before its "offline" alert opens
# (default 5; 1-1440). A wrong token or an agent < 2.5 is never "offline".
# PIDECK_OFFLINE_ALERT_MINUTES=5
# Installer only (read from the shell environment, not from this file):
# scripts/install.sh --update takes a pg_dump -Fc to ~/backups/ before it
# migrates the database; PIDECK_NO_DB_BACKUP=1 skips that (= --no-db-backup).
# PIDECK_CHECK_LOGIN_FILE=<0600 file with the admin password> makes
# --check-login test the login without a prompt (for scripts).
# Tests only: PIDECK_TEST_PG_URL=<admin URL> runs the *.db.test.ts suites.
# 1 = POST /api/system/update is a 409 no-op (E2E runs set this).
# PIDECK_DISABLE_SYSTEM_UPDATE=1
